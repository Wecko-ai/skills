{
  "description": "Phone ping when a Claude Code session is really done (no background work left), only when you are away from the Mac.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kage-agent-notify\" claude-stop",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kage-agent-notify\" claude-end",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
